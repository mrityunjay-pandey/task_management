# PostgreSQL connection string (Neon, Supabase, or any hosted Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/taskdb?schema=public"

# Port the NestJS server listens on
PORT=4000

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN="http://localhost:3000"

# development | production - affects the session cookie's SameSite/Secure
# settings (production uses SameSite=None; Secure for cross-domain
# frontend/backend deployments; leave unset or "development" for local use)
NODE_ENV=development

# Secret used to sign the guest session cookie/JWT
SESSION_SECRET="replace-with-a-long-random-string"
